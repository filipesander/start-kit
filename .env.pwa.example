# ============================================
# PWA Configuration Example
# ============================================

# Application Name (aparecerá no ícone PWA)
APP_NAME="Sistema Moderno"

# URL da aplicação (importante para PWA)
APP_URL=https://seu-dominio.com

# Ambiente (production recomendado para PWA)
APP_ENV=production

# HTTPS é OBRIGATÓRIO para PWA
# Certifique-se de que APP_URL usa https://

# Forçar HTTPS (Laravel)
FORCE_HTTPS=true

# ============================================
# Configurações Adicionais PWA
# ============================================

# Cor do tema (mesma do manifest.json)
PWA_THEME_COLOR="#667eea"

# Nome curto para PWA
PWA_SHORT_NAME="Sistema"

# Descrição do app
PWA_DESCRIPTION="Sistema de Gerenciamento - PWA"

# ============================================
# Service Worker
# ============================================

# Versão do cache (incrementar ao atualizar)
PWA_CACHE_VERSION=1

# Tempo de cache (em segundos)
PWA_CACHE_TIME=3600

# ============================================
# Notificações Push (Opcional)
# ============================================

# VAPID Keys para Web Push
# Gerar em: https://web-push-codelab.glitch.me/

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:seu-email@dominio.com

# ============================================
# Performance
# ============================================

# Ativar compressão Gzip
COMPRESS_ENABLED=true

# Cache de views
VIEW_CACHE_ENABLED=true

# Cache de rotas
ROUTE_CACHE_ENABLED=true

# Cache de config
CONFIG_CACHE_ENABLED=true
